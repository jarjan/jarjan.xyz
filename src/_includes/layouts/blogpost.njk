---
layout: layouts/base.njk
ogType: article
ownHeading: true
---

<article class="post">
  <header>
    <h1 class="post__title">{{ title }}</h1>
    <small>
      <time datetime="{{ page.date | isoDate }}">{{ page.date.toLocaleDateString("kk-KZ") }}</time>
      {%- if updated %}
        {%- set updatedTime %}<time datetime="{{ updated | isoDate }}">{{ updated.toLocaleDateString("kk-KZ") }}</time>{% endset %}
        · {{ t.updated | replace("%s", updatedTime) | safe }}
      {%- endif %}
      · {{ t.readTime | replace("%s", content | timeToRead("kk" if lang == "kk" else "en", { style: "short" })) }}
    </small>
  </header>
  {% set headings = content | toc %}
  {% if headings.length >= 3 and toc !== false %}
    <nav class="toc" aria-labelledby="toc-title">
      <div class="toc__inner">
        <p class="toc__title" id="toc-title">{{ t.contents }}</p>
        <ol class="toc__list">
          {% for heading in headings %}
            <li>
              <a href="#{{ heading.id }}">{{ heading.text | safe }}</a>
              {% if heading.children.length %}
                <ol>
                  {% for child in heading.children %}
                    <li><a href="#{{ child.id }}">{{ child.text | safe }}</a></li>
                  {% endfor %}
                </ol>
              {% endif %}
            </li>
          {% endfor %}
        </ol>
      </div>
    </nav>
  {% endif %}
  {{ content | safe }}
  {% include 'disclaimer.njk' %}
</article>
<script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "BlogPosting",
    "headline": {{ title | dump | safe }},
    "description": {{ description | dump | safe }},
    "inLanguage": "{{ lang }}",
    "url": "https://jarjan.xyz{{ page.url }}",
    "image": "https://jarjan.xyz{{ ogImage }}",
    "datePublished": "{{ page.date | isoDate }}",
    "dateModified": "{{ (updated or page.date) | isoDate }}",
    "author": { "@type": "Person", "name": "Zharzhan Kulmyrza", "url": "https://jarjan.xyz" }
  }
</script>
