---
layout: layouts/base.njk
ogType: article
ownHeading: true
---

<article class="post">
  <header>
    <h1 class="post__title">{{ title }}</h1>
    <small>
      <time datetime="{{ page.date | isoDate }}">{{ page.date.toLocaleDateString("kk-KZ") }}</time> · {{ content | timeToRead (lang) }}
    </small>
  </header>
  {{ content | safe }}
  {% set disclaimerLang = lang if disclaimer[lang] else 'en' %}
  <aside class="disclaimer" lang="{{ disclaimerLang }}" aria-label="{{ t.disclaimer }}">
    <p>{{ disclaimer[disclaimerLang] }}</p>
  </aside>
</article>
