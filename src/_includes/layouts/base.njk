<!DOCTYPE html>
<html lang="{{ lang }}">
  <head>
    <meta charset="utf-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1"/>
    <meta name="generator" content="{{ eleventy.generator }}"/>
    {% set pageTitle = title if title == t.name else title + ' | ' + t.name %}
    {% set pageUrl = 'https://jarjan.xyz' + page.url %}
    <title>{{ pageTitle }}</title>
    <meta name="description" content="{{ description }}"/>
    {% if page.url == '/404.html' %}
      <meta name="robots" content="noindex"/>
    {% else %}
      <link rel="canonical" href="{{ pageUrl }}"/>
    {% endif %}
    {% if translation %}
      {% set enUrl = page.url if lang == 'en' else translation %}
      {% set kkUrl = page.url if lang == 'kk' else translation %}
      <link rel="alternate" hreflang="en" href="https://jarjan.xyz{{ enUrl }}"/>
      <link rel="alternate" hreflang="kk" href="https://jarjan.xyz{{ kkUrl }}"/>
      <link rel="alternate" hreflang="x-default" href="https://jarjan.xyz{{ enUrl }}"/>
    {% endif %}
    <meta property="og:site_name" content="{{ t.name }}"/>
    <meta property="og:locale" content="{{ t.locale }}"/>
    <meta property="og:title" content="{{ pageTitle }}"/>
    <meta property="og:description" content="{{ description }}"/>
    <meta property="og:type" content="{{ ogType or 'website' }}"/>
    <meta property="og:url" content="{{ pageUrl }}"/>
    <meta property="og:image" content="https://jarjan.xyz/og-image.png"/>
    <meta property="og:image:width" content="1200"/>
    <meta property="og:image:height" content="630"/>
    <meta property="og:image:alt" content="Zharzhan Kulmyrza – jarjan.xyz"/>
    {% if ogType == 'article' %}
      <meta property="article:published_time" content="{{ page.date | isoDate }}"/>
      <meta property="article:author" content="Zharzhan Kulmyrza"/>
    {% endif %}
    <meta name="twitter:card" content="summary_large_image"/>
    {% set fontFiles = ['cyrillic-ext', 'cyrillic'] if lang == 'kk' else ['latin'] %}
    {% for file in fontFiles %}
    <link rel="preload" href="/fonts/source-sans-3-{{ file }}.woff2" as="font" type="font/woff2" crossorigin/>
    {% endfor %}
    <link rel="stylesheet" href="/css/styles.css"/>
    <link rel="alternate" href="/feed.xml" type="application/atom+xml" title="Zharzhan Kulmyrza"/>
    <link rel="me" href="https://mastodon.social/@jarjan"/>
    <link rel="me" href="https://threads.com/@jarjanxyz"/>
    <link rel="me" href="https://bsky.app/profile/jarjan.xyz"/>
    <link rel="me" href="https://sifa.id/p/jarjan.xyz"/>
  </head>
  <body>
    <header class="header">
      <a href="/" title="jarjan.xyz" class="header__logo">
        <svg viewBox="0 0 295 295" xmlns="http://www.w3.org/2000/svg" width="40" height="40" aria-hidden="true">
          <g fill="none" fill-rule="evenodd">
            <path fill="#5990dc" d="M0 0h295v295H0z"/>
            <path
              d="M166.44 188.184c0 4.512.432 8.568 1.296 12.168.864 3.6 2.304 6.672 4.32 9.216 2.016 2.544 4.68 4.512 7.992 5.904 3.312
                1.392 7.416 2.088 12.312 2.088 1.632 0 3.312-.072 5.04-.216a25.244 25.244 0 0 0 5.04-.936l-1.152-19.152c-1.728.864-3.6
                1.296-5.616 1.296-1.824 0-3.264-.48-4.32-1.44-1.056-.96-1.824-2.16-2.304-3.6a17.82 17.82 0 0 1-.864-4.608 76.558 76.558 0
                0 1-.144-4.464v-71.424h-21.6v75.168z"
              fill="#FFF"/>
            <path
              d="M165 89.576c0-3.456 1.224-6.408 3.672-8.856 2.448-2.448 5.4-3.672 8.856-3.672 3.456 0 6.408 1.224 8.856 3.672 2.448
                2.448 3.672 5.4 3.672 8.856 0 3.456-1.224 6.408-3.672 8.856-2.448 2.448-5.4 3.672-8.856 3.672-3.456
                0-6.408-1.224-8.856-3.672-2.448-2.448-3.672-5.4-3.672-8.856z"
              fill="#C40F25" class="header__logo-dot"/>
            <path
              d="M156.072 148.872c0 4.704-.408 9.264-1.224 13.68-.816 4.416-2.376 8.328-4.68 11.736-2.304 3.408-5.592 6.144-9.864
                8.208-4.272 2.064-9.864 3.096-16.776 3.096-8.064 0-14.88-1.92-20.448-5.76s-9.168-9.84-10.8-18l20.592-5.04c.288 2.496
                1.416 4.608 3.384 6.336 1.968 1.728 4.2 2.592 6.696 2.592 2.592 0 4.608-.648 6.048-1.944 1.44-1.296 2.496-2.904
                3.168-4.824.672-1.92 1.08-4.008 1.224-6.264.144-2.256.216-4.344.216-6.264V81.048h22.464v67.824z"
              fill="#FFF"/>
          </g>
        </svg>
        <span class="sr-only">{{ t.name }}</span>
      </a>
      {% if ownHeading %}
        <p class="header__name">{{ t.name }}</p>
      {% else %}
        <h1 class="header__name">{{ t.name }}</h1>
      {% endif %}
      <nav class="header__links">
        {% set isBlog = page.url == t.blogUrl or page.url.startsWith('/blog/') %}
        <a href="{{ t.blogUrl }}" class="{{ 'active' if isBlog }}" {% if page.url == t.blogUrl %}aria-current="page"{% endif %}>{{ t.blog }}</a>
        <a href="{{ t.projectsUrl }}" class="{{ 'active' if page.url == t.projectsUrl }}" {% if page.url == t.projectsUrl %}aria-current="page"{% endif %}>{{ t.projects }}</a>
      </nav>
      {% if translation %}
        <a href="{{ translation }}" class="header__lang" hreflang="{{ 'en' if lang == 'kk' else 'kk' }}" lang="{{ 'en' if lang == 'kk' else 'kk' }}">{{ t.translationLabel }}</a>
      {% endif %}
    </header>
    <hr/>
    <main class="content">
      {{ content | safe }}
    </main>
    <hr/>
    <footer class="footer">
      <div class="footer__copy">
        {% if 'kk' in lang %}
          <span aria-hidden="true">🇰🇿</span> Қазақстанда туып өстім.
          <span aria-hidden="true">🇩🇪</span> Германияда код жазып өмір сүремін. <br/> © Жаржан Құлмырза {{ currentYear }}
        {% else %}
          Born and raised in
          <span aria-hidden="true">🇰🇿</span> Kazakhstan. Living and coding in
          <span aria-hidden="true">🇩🇪</span> Germany. <br/> © Zharzhan Kulmyrza {{ currentYear }}
        {% endif %}
      </div>
      <div class="footer__links">
        {% include 'contacts_links.njk' %}
      </div>
    </footer>
    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "Person",
        "name": "Zharzhan Kulmyrza",
        "jobTitle": "Staff Software Engineer",
        "worksFor": { "@type": "Organization", "name": "Delivery Hero" },
        "url": "https://jarjan.xyz",
        "email": "hey@jarjan.xyz",
        "sameAs": [
          "https://github.com/jarjan",
          "https://bsky.app/profile/jarjan.xyz",
          "https://t.me/zharzhan",
          "https://linkedin.com/in/zharzhan",
          "https://threads.com/@jarjanxyz"
        ]
      }
    </script>
    <script async defer src="https://scripts.simpleanalyticscdn.com/latest.js"></script>
    <noscript><img src="https://queue.simpleanalyticscdn.com/noscript.gif" alt="" referrerpolicy="no-referrer-when-downgrade"/></noscript>
  </body>
</html>
